# Copia este archivo como .env y cambia los valores. El archivo .env NUNCA se sube al repositorio.

# --- Seguridad ---
# Clave para usar la API del bot (encabezado X-API-Key). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_API_KEY=CAMBIA_ESTA_CLAVE

# --- Cuenta spot de MEXC (opcional) ---
# Con estas claves el bot lee tu saldo y manda cada orden a /api/v3/order/test: MEXC la valida y NO la ejecuta.
# Crea la API key en MEXC con permisos de "lectura de cuenta" y "trading spot". NUNCA actives retiros.
# Estas claves solo viven aquí: no se envían al LLM, al navegador ni a la base de datos.
MEXC_API_KEY=
MEXC_API_SECRET=
# Monto en USDT de cada orden de prueba de compra (0 = el mismo monto que el simulador)
MEXC_MONTO_PRUEBA_USDT=0

# --- Mercado ---
MODO=PAPER
SIMBOLO=BTCUSDT
INTERVALO=1d
MEXC_URL=https://api.mexc.com

# --- LLM local (Ollama). Debe ser localhost: el bot no acepta LLM en la nube ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELO=qwen2.5:7b
OLLAMA_TIMEOUT_S=120

# --- Simulación Paper y límites de riesgo (el LLM no puede cambiarlos) ---
CAPITAL_INICIAL=50000
COSTO=0.0
DESLIZAMIENTO=0.0005
EXPOSICION_MAX=1.0
PERDIDA_DIARIA_MAX=0.05
ANTIGUEDAD_MAX_H=26
REVISAR_CADA_S=60

# Umbral del "modelo sin LLM" en la comparación (rendimiento esperado mínimo para estar comprado)
UMBRAL_MODELO=0.0

# --- Rutas ---
DB_PATH=data/bot_v2.sqlite
MODELO_PATH=models/modelo_mlp.json
